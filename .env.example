# Copy to .env and fill in credentials. Never commit .env.
LLM_API_KEY=
LLM_MODEL=openai/gpt-6-luna
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_REASONING_EFFORT=none

SEARCH_ENDPOINT=https://google.serper.dev/search
SEARCH_API_KEY=
GEOCODING_URL=https://nominatim.openstreetmap.org/search

DATA_DIR=./torob-dataset
DB_PATH=./data/torob.sqlite
TZ=Asia/Tehran
DEFAULT_LAT=35.7219
DEFAULT_LNG=51.4097
DEFAULT_RADIUS_KM=4
AGENT_MAX_TOOL_ROUNDS=8
AGENT_TIMEOUT_MS=60000
TOOL_LOG_PATH=./logs/tool-calls.jsonl
